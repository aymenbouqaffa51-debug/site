# Response headers for Cloudflare Pages / Netlify.
#
# GENERATED by build/build.py from build/shell.py — do not hand-edit.
#
# GitHub Pages ignores this file entirely, which is why the same Content
# Security Policy also ships as <meta http-equiv="Content-Security-Policy"> in
# every page (see build/shell.py: CSP_META). Directives below that a browser
# ignores inside a meta policy — frame-ancestors, upgrade-insecure-requests —
# exist only here.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.styxsec.tech https://cdn.intra.42.fr https://intra.42.fr https://*.intra.42.fr; font-src 'self'; connect-src 'self' https://api.styxsec.tech http://localhost:* http://127.0.0.1:*; frame-src https://www.openstreetmap.org; form-action 'self'; base-uri 'self'; object-src 'none'; manifest-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Assets are referenced with ?v=<content hash>, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so a new build is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
